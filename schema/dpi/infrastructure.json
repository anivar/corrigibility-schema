{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:corrigibility:dpi/infrastructure.json",
  "title": "Corrigibility DPI Infrastructure Manifest",
  "description": "Operator's Affidavit (paper §A.1): a signed good-faith declaration against the five corrigibility tests. Claiming a test binds the operator to its criteria fields — a claim whose evidence contradicts it is schema-invalid, and an honest failure is always representable.",
  "type": "object",
  "required": [
    "protocol_version",
    "system_id",
    "manifest_version",
    "timestamp",
    "operator",
    "topology",
    "layers",
    "code",
    "exit",
    "audit_surface",
    "governance",
    "fork",
    "corrigibility_claim",
    "operator_signature"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "type": "string", "pattern": "^4\\.[0-9]+$" },
    "system_id": { "type": "string", "minLength": 1 },
    "manifest_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "previous_manifest_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Manifest chain (Rule A.10). Audits point at manifests; manifests never point at audits."
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "operator": {
      "allOf": [{ "$ref": "urn:corrigibility:common.json#/$defs/actor" }],
      "unevaluatedProperties": false
    },
    "topology": {
      "type": "string",
      "enum": ["centralized_sovereign", "federated_protocol", "market_platform", "open_commons"],
      "description": "Paper, DPI Trilemma: centralized topology compresses governance variety."
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "description": "Layer decomposition; tests propagate by AND across layers. Per-layer findings live in the audit, keyed by layer_id.",
      "items": {
        "type": "object",
        "required": ["layer_id", "layer_type", "introduced_at"],
        "additionalProperties": false,
        "properties": {
          "layer_id": { "type": "string", "minLength": 1 },
          "layer_type": {
            "type": "string",
            "enum": ["protocol", "implementation", "operations", "data", "presentation"]
          },
          "domain": {
            "type": "string",
            "enum": ["identity", "payments", "data_exchange", "consent", "credentials", "registry", "messaging", "other"]
          },
          "introduced_at": { "type": "string", "format": "date" },
          "spec_open": { "type": "boolean" },
          "implementation_open": { "type": "boolean" },
          "deprecated": { "type": "boolean", "default": false },
          "deprecated_at": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "code": {
      "type": "object",
      "description": "CODE: the logic that decides is publicly inspectable (paper §4 Test 2).",
      "required": ["source_available", "license_open", "build_reproducible"],
      "additionalProperties": false,
      "properties": {
        "source_available": { "type": "boolean" },
        "source_repository_url": { "type": "string", "format": "uri" },
        "license_open": { "type": "boolean" },
        "license_id": { "type": "string", "description": "SPDX identifier." },
        "build_reproducible": { "type": "boolean" },
        "build_proof_url": { "type": "string", "format": "uri" },
        "decision_rule_legible": {
          "type": "boolean",
          "description": "Outward CODE (Dual Exercise): the operative rule in a subject's case is identifiable and stated."
        },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "audit_surface": { "$ref": "urn:corrigibility:common.json#/$defs/audit_surface" },
    "subject_receipts": { "$ref": "urn:corrigibility:common.json#/$defs/subject_receipts" },
    "exit": {
      "type": "object",
      "description": "EXIT: participation is reversible without disproportionate penalty (paper §4 Test 1). Essential systems discharge via verified FEE.",
      "required": ["legal_barrier", "alternative_exists"],
      "additionalProperties": false,
      "properties": {
        "legal_barrier": { "type": "boolean", "description": "Refusal incurs criminal or coercive legal consequence." },
        "alternative_exists": { "type": "boolean" },
        "penalty_ratio": {
          "type": "number",
          "minimum": 0,
          "description": "p = cost(non-digital alternative) / cost(digital). Threshold in the cited calibration profile (default p ≤ 1.2)."
        },
        "data_portability": { "type": "boolean" },
        "deletion_available": { "type": "boolean" },
        "discharge_path": {
          "type": "string",
          "enum": ["literal_exit", "verified_fee"],
          "description": "Essential systems can only claim verified_fee."
        },
        "exit_procedure_url": { "type": "string", "format": "uri" },
        "fee": { "$ref": "urn:corrigibility:common.json#/$defs/exit_fee" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "governance": {
      "allOf": [{ "$ref": "urn:corrigibility:common.json#/$defs/governance" }],
      "unevaluatedProperties": false
    },
    "escalation": { "$ref": "urn:corrigibility:common.json#/$defs/escalation" },
    "fork": {
      "type": "object",
      "description": "FORK: independent reproduction (paper §4 Test 5). Constructed barriers disqualify; natural barriers are informational.",
      "required": ["legally_permitted", "license_permissive"],
      "additionalProperties": false,
      "properties": {
        "legally_permitted": { "type": "boolean" },
        "license_permissive": { "type": "boolean" },
        "artifacts_available": { "type": "boolean" },
        "constructed_barriers": { "type": "array", "items": { "type": "string" } },
        "natural_barriers": { "type": "array", "items": { "type": "string" } },
        "successful_forks": { "type": "array", "items": { "type": "string" } },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "corrigibility_claim": {
      "type": "object",
      "description": "Good-faith self-claim per test; the audit's tests object is the authoritative finding. Each true claim triggers its criteria conditional below.",
      "required": ["EXIT", "CODE", "AUDIT", "GOVERN", "FORK"],
      "additionalProperties": false,
      "properties": {
        "EXIT": { "type": "boolean" },
        "CODE": { "type": "boolean" },
        "AUDIT": { "type": "boolean" },
        "GOVERN": { "type": "boolean" },
        "FORK": { "type": "boolean" }
      }
    },
    "calibration_profile": { "$ref": "urn:corrigibility:common.json#/$defs/calibration_profile" },
    "revocation": { "$ref": "urn:corrigibility:common.json#/$defs/revocation" },
    "operator_signature": { "$ref": "urn:corrigibility:common.json#/$defs/signature" }
  },
  "allOf": [
    {
      "$comment": "Claim binds criteria: EXIT claimed ⇒ no legal barrier, and the penalty evidence + discharge path are stated.",
      "if": {
        "properties": { "corrigibility_claim": { "properties": { "EXIT": { "const": true } }, "required": ["EXIT"] } },
        "required": ["corrigibility_claim"]
      },
      "then": {
        "properties": {
          "exit": {
            "properties": { "legal_barrier": { "const": false } },
            "required": ["legal_barrier", "penalty_ratio", "discharge_path"]
          }
        }
      }
    },
    {
      "$comment": "CODE claimed ⇒ the inspectability criteria hold and the repository is named.",
      "if": {
        "properties": { "corrigibility_claim": { "properties": { "CODE": { "const": true } }, "required": ["CODE"] } },
        "required": ["corrigibility_claim"]
      },
      "then": {
        "properties": {
          "code": {
            "properties": {
              "source_available": { "const": true },
              "license_open": { "const": true }
            },
            "required": ["source_available", "license_open", "source_repository_url", "license_id"]
          }
        }
      }
    },
    {
      "$comment": "AUDIT claimed ⇒ permissionless checkability is actually offered.",
      "if": {
        "properties": { "corrigibility_claim": { "properties": { "AUDIT": { "const": true } }, "required": ["AUDIT"] } },
        "required": ["corrigibility_claim"]
      },
      "then": {
        "properties": {
          "audit_surface": {
            "properties": {
              "third_party_testing_permitted": { "const": true },
              "error_rates_publishable": { "const": true }
            },
            "required": ["third_party_testing_permitted", "error_rates_publishable"]
          }
        }
      }
    },
    {
      "$comment": "GOVERN claimed ⇒ a binding mechanism is asserted, which cascades into the Rule A.9 proof requirements.",
      "if": {
        "properties": { "corrigibility_claim": { "properties": { "GOVERN": { "const": true } }, "required": ["GOVERN"] } },
        "required": ["corrigibility_claim"]
      },
      "then": {
        "properties": {
          "governance": {
            "properties": { "binding_mechanism": { "const": true } },
            "required": ["binding_mechanism"]
          }
        }
      }
    },
    {
      "$comment": "FORK claimed ⇒ reproduction is legally permitted under a permissive license with artifacts stated.",
      "if": {
        "properties": { "corrigibility_claim": { "properties": { "FORK": { "const": true } }, "required": ["FORK"] } },
        "required": ["corrigibility_claim"]
      },
      "then": {
        "properties": {
          "fork": {
            "properties": {
              "legally_permitted": { "const": true },
              "license_permissive": { "const": true }
            },
            "required": ["legally_permitted", "license_permissive", "artifacts_available"]
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:corrigibility:epi/infrastructure.json",
  "title": "Corrigibility EPI Infrastructure Manifest",
  "description": "Operator's Affidavit for Epistemic Public Infrastructure (companion paper §A.1): LWD-R transparency with per-pillar attestation, the Action Boundary Protocol at every tier, compute and data capture as disclosure, and tiered risk classification. An API deployer names what it cannot attest instead of guessing vendor internals.",
  "type": "object",
  "required": [
    "protocol_version",
    "system_id",
    "manifest_version",
    "timestamp",
    "operator",
    "tier",
    "topology",
    "layers",
    "lwd_r",
    "code",
    "exit",
    "audit_surface",
    "governance",
    "compute",
    "data",
    "fork",
    "action_boundaries",
    "corrigibility_claim",
    "operator_signature"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "type": "string", "pattern": "^4\\.[0-9]+$" },
    "system_id": { "type": "string", "minLength": 1 },
    "manifest_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "previous_manifest_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "operator": {
      "allOf": [{ "$ref": "urn:corrigibility:common.json#/$defs/actor" }],
      "unevaluatedProperties": false
    },
    "tier": {
      "type": "string",
      "enum": ["trivial", "decision_support", "high_stakes"],
      "description": "Risk classification (companion paper). The Action Boundary applies at every tier; high_stakes additionally requires the full conjunction enforced below."
    },
    "topology": {
      "type": "string",
      "enum": ["centralized_sovereign", "federated_protocol", "market_platform", "open_commons"]
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer_id", "layer_type", "introduced_at"],
        "additionalProperties": false,
        "properties": {
          "layer_id": { "type": "string", "minLength": 1 },
          "layer_type": {
            "type": "string",
            "enum": ["inference", "orchestration", "retrieval", "training", "evaluation", "action", "presentation"]
          },
          "introduced_at": { "type": "string", "format": "date" },
          "spec_open": { "type": "boolean" },
          "implementation_open": { "type": "boolean" },
          "deprecated": { "type": "boolean", "default": false },
          "deprecated_at": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "lwd_r": {
      "type": "object",
      "description": "Logic–Weights–Data–Representation transparency. Every pillar names its attestor: an operator who cannot see vendor internals says so instead of inventing them.",
      "required": ["logic", "weights", "data", "representation"],
      "additionalProperties": false,
      "properties": {
        "logic": {
          "type": "object",
          "required": ["attestor", "inspectable", "deterministic_envelope"],
          "additionalProperties": false,
          "properties": {
            "attestor": { "$ref": "#/$defs/pillar_attestor" },
            "vendor_attestation_url": { "type": "string", "format": "uri" },
            "inspectable": { "type": "boolean" },
            "deterministic_envelope": {
              "type": "boolean",
              "description": "Logic wraps stochastic inference inside the Action Boundary."
            },
            "orchestration_url": { "type": "string", "format": "uri" },
            "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
          }
        },
        "weights": {
          "type": "object",
          "required": ["attestor", "open", "model_id"],
          "additionalProperties": false,
          "properties": {
            "attestor": { "$ref": "#/$defs/pillar_attestor" },
            "vendor_attestation_url": { "type": "string", "format": "uri" },
            "open": { "type": "boolean" },
            "model_id": { "type": "string", "minLength": 1 },
            "weights_url": { "type": "string", "format": "uri" },
            "license": { "type": "string" },
            "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
          }
        },
        "data": {
          "type": "object",
          "required": ["attestor", "provenance_documented", "local_storage"],
          "additionalProperties": false,
          "properties": {
            "attestor": { "$ref": "#/$defs/pillar_attestor" },
            "vendor_attestation_url": { "type": "string", "format": "uri" },
            "provenance_documented": { "type": "boolean" },
            "local_storage": { "type": "boolean" },
            "provenance_url": { "type": "string", "format": "uri" },
            "rag_filtering": { "type": "boolean" },
            "datasheet_url": { "type": "string", "format": "uri" },
            "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
          }
        },
        "representation": {
          "type": "object",
          "required": ["attestor", "bias_assessed"],
          "additionalProperties": false,
          "properties": {
            "attestor": { "$ref": "#/$defs/pillar_attestor" },
            "vendor_attestation_url": { "type": "string", "format": "uri" },
            "bias_assessed": { "type": "boolean" },
            "communities_consulted": { "type": "array", "items": { "type": "string" } },
            "assessment_url": { "type": "string", "format": "uri" },
            "model_card_url": { "type": "string", "format": "uri" },
            "operative_r": {
              "type": "object",
              "description": "Operative Representation: the schema that emerges under deployment conditions, not the trained artifact in isolation. Undeclared deployment variables break the derivation chain and fail R.",
              "additionalProperties": false,
              "properties": {
                "quantization": { "type": "string" },
                "routing": { "type": "string" },
                "pruning": { "type": "string" },
                "output_filtering": { "type": "string" },
                "probe_set_url": { "type": "string", "format": "uri" },
                "tolerance": { "type": "number", "minimum": 0, "description": "Declared statistical tolerance for third-party reproduction (e.g. total-variation ε at sample size n)." },
                "probe_sample_size": { "type": "integer", "minimum": 1 }
              }
            },
            "change_control": {
              "type": "object",
              "description": "R-Layer Change Control: material representation changes require pre-deployment notice, a review window with suspensive effect, and versioned diffs so the operative schema is reconstructable for any date. Emergency changes disclose immediately and bear the burden of proof.",
              "additionalProperties": false,
              "properties": {
                "materiality_threshold_declared": { "type": "boolean" },
                "pre_deployment_notice_days": { "type": "integer", "minimum": 0, "description": "Calibration in the cited profile (default 21); the structural bound is the Temporal Stability Condition." },
                "review_body": { "type": "string" },
                "suspensive_effect": { "type": "boolean" },
                "versioned_schema_diffs": { "type": "boolean" },
                "diffs_url": { "type": "string", "format": "uri" }
              }
            },
            "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
          }
        }
      }
    },
    "code": {
      "type": "object",
      "description": "CODE over orchestration logic; model pillars are scored under lwd_r.",
      "required": ["source_available", "license_open", "build_reproducible"],
      "additionalProperties": false,
      "properties": {
        "source_available": { "type": "boolean" },
        "source_repository_url": { "type": "string", "format": "uri" },
        "license_open": { "type": "boolean" },
        "license_id": { "type": "string" },
        "build_reproducible": { "type": "boolean" },
        "build_proof_url": { "type": "string", "format": "uri" },
        "decision_rule_legible": { "type": "boolean" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "audit_surface": { "$ref": "urn:corrigibility:common.json#/$defs/audit_surface" },
    "action_boundaries": {
      "type": "object",
      "description": "Action Boundary Protocol: the deterministic envelope wrapping stochastic inference — the model proposes, the validator disposes. Required at every tier; enforced=false is a legal, honest disclosure and a failing one.",
      "required": ["enforced", "mechanism"],
      "additionalProperties": false,
      "properties": {
        "enforced": { "type": "boolean" },
        "mechanism": {
          "type": "string",
          "enum": ["hard_coded", "policy_engine", "human_approval", "hybrid", "none"]
        },
        "executed_outside_llm_context": {
          "type": "boolean",
          "description": "Prompt-injectable boundaries are not boundaries."
        },
        "termination_criteria_explicit": { "type": "boolean", "description": "GDoS prevention." },
        "permitted_actions": { "type": "array", "items": { "type": "string" } },
        "prohibited_actions": { "type": "array", "items": { "type": "string" } },
        "human_required_for": { "type": "array", "items": { "type": "string" } },
        "boundary_spec_url": { "type": "string", "format": "uri" },
        "enforcement_placement": {
          "type": "string",
          "enum": ["action_proposal", "effect_surface", "hybrid"],
          "description": "Untyped action channels move the gate to the effect surface; the invariant is a deterministic, specification-checkable gate before irreversible effect."
        },
        "specification_lifetime_days": { "type": "integer", "minimum": 0 },
        "renewal_requires_fresh_grant": { "type": "boolean" },
        "accountable_authority_checkpoint": {
          "type": "object",
          "description": "An accountable authority whose grant is fresh, whose liability binds, and whose correction satisfies the two-sided Temporal Stability Condition.",
          "additionalProperties": false,
          "properties": {
            "scope": { "type": "string", "enum": ["per_decision", "per_class", "boundary"] },
            "grant_fresh": { "type": "boolean" },
            "liability_binds": { "type": "boolean" },
            "correction_within_window": { "type": "boolean", "description": "Lower bound: correction outpaces error accumulation." },
            "correction_upper_bound_enforced": { "type": "boolean", "description": "Upper bound: corrections cannot outrun the affected parties' capacity to observe and contest them." }
          }
        },
        "scale_bounds": {
          "type": "object",
          "description": "Scale as a governed variable: bound environmental variety where governance variety cannot rise to match.",
          "additionalProperties": false,
          "properties": {
            "fan_out_limit": { "type": "integer", "minimum": 0 },
            "action_rate_limit": { "type": "number", "minimum": 0 },
            "blast_radius_cap": { "type": "string" },
            "enforced": { "type": "boolean" }
          }
        },
        "explicit_exception_pathways": { "type": "boolean" },
        "guaranteed_fallbacks": { "type": "boolean", "description": "Without fallbacks the failure mode concentrates on the least-resourced stratum." },
        "fallback_spec_url": { "type": "string", "format": "uri" },
        "nested_delegation": {
          "type": "object",
          "description": "Corrigibility of a nested deployment is the minimum over delegation depth.",
          "additionalProperties": false,
          "properties": {
            "max_delegation_depth": { "type": "integer", "minimum": 0 },
            "authority_attenuation_enforced": { "type": "boolean" },
            "audit_reconstructs_across_depth": { "type": "boolean" },
            "exit_propagates_down_chain": { "type": "boolean" }
          }
        },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "machine_verifiable_legitimacy": {
      "type": "object",
      "description": "Authority and attribution as record-borne acts: items (a)–(d); (e) origination is declared separately.",
      "additionalProperties": false,
      "properties": {
        "authority_credentials_machine_interpretable": { "type": "boolean" },
        "revocation_propagation_observable": { "type": "boolean" },
        "execution_traces_tamper_evident": { "type": "boolean" },
        "incident_mitigation_automated": { "type": "boolean" }
      }
    },
    "origination_marking": {
      "type": "object",
      "description": "The record states whether a human or an agent acted; absence of a marker is never evidence of human operation.",
      "additionalProperties": false,
      "properties": {
        "records_operator_kind": { "type": "boolean" },
        "positive_signed_marker_required": { "type": "boolean" },
        "marker_narrows_authority_only": { "type": "boolean" }
      }
    },
    "subject_receipts": { "$ref": "urn:corrigibility:common.json#/$defs/subject_receipts" },
    "compute": {
      "type": "object",
      "description": "Compute Capture disclosure: C_train against community-accessible compute, judged under the cited calibration profile's κ. Capture verdicts belong to the audit.",
      "required": ["inference_accessible", "training_accessible"],
      "additionalProperties": false,
      "properties": {
        "inference_accessible": { "type": "boolean" },
        "training_accessible": { "type": "boolean" },
        "estimated_training_cost_usd": { "type": "number", "minimum": 0 },
        "estimated_inference_cost_usd": { "type": "number", "minimum": 0 },
        "community_compute_estimate_usd": { "type": "number", "minimum": 0, "description": "C_accessible, with the estimate's basis stated in notes or linked evidence." },
        "swap_time_minutes": { "type": "integer", "minimum": 0 },
        "alternative_vendors": { "type": "array", "items": { "type": "string" } },
        "training_code_available": { "type": "boolean" },
        "data_manifest_available": { "type": "boolean" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "data": {
      "type": "object",
      "description": "Data Capture disclosure (Definition 5.2): D_required against community-accessible data under the profile's κ_D; the upstream-dependency taxonomy is the observable.",
      "required": ["training_corpus_reproducible", "upstream_dependencies"],
      "additionalProperties": false,
      "properties": {
        "training_corpus_reproducible": { "type": "boolean" },
        "required_to_accessible_ratio": { "type": "number", "minimum": 0 },
        "public_substitute_equivalence_auditable": { "type": "boolean", "description": "A public substitute closes the gap only if its equivalence is auditable." },
        "upstream_dependencies": {
          "type": "object",
          "description": "§5.2 capture vectors; true = present and not publicly reproducible.",
          "additionalProperties": false,
          "properties": {
            "synthetic_data_from_proprietary_models": { "type": "boolean" },
            "distilled_outputs_from_closed_apis": { "type": "boolean" },
            "proprietary_evaluation_sets": { "type": "boolean" },
            "rlhf_traces_or_preference_data_undisclosed": { "type": "boolean" },
            "reward_models_unavailable": { "type": "boolean" },
            "tokenizer_or_filter_rules_undisclosed": { "type": "boolean" }
          }
        },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "revalidation": {
      "type": "object",
      "description": "Variety Drift monitoring: Δ(t) against τ.",
      "additionalProperties": false,
      "properties": {
        "monitoring_enabled": { "type": "boolean" },
        "monitoring_frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "quarterly"] },
        "drift_threshold": { "type": "number", "minimum": 0, "maximum": 1, "description": "τ" },
        "last_revalidation": { "type": "string", "format": "date" }
      }
    },
    "exit": {
      "type": "object",
      "description": "EXIT for learned systems: retrieval-layer removal, deletion with an SLA, and regeneration resistance — purge alone is not the test.",
      "required": ["rag_opt_out", "regeneration_resistant"],
      "additionalProperties": false,
      "properties": {
        "rag_opt_out": { "type": "boolean" },
        "regeneration_resistant": {
          "type": "boolean",
          "description": "Nothing about the ended authority, including regeneration from retained derivatives, is inferable from what persists."
        },
        "discharge_path": { "type": "string", "enum": ["literal_exit", "verified_fee"] },
        "deletion_procedure_url": { "type": "string", "format": "uri" },
        "deletion_sla_days": { "type": "integer", "minimum": 0 },
        "fee": { "$ref": "urn:corrigibility:common.json#/$defs/exit_fee" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "governance": {
      "allOf": [{ "$ref": "urn:corrigibility:common.json#/$defs/governance" }],
      "unevaluatedProperties": false,
      "properties": {
        "citizen_constraint_registry": {
          "type": "object",
          "description": "Recognized subject-class representatives lodge protective constraints the validator evaluates before execution — standing at the boundary, not recourse after.",
          "additionalProperties": false,
          "properties": {
            "exposed": { "type": "boolean" },
            "registry_url": { "type": "string", "format": "uri" },
            "evaluated_pre_execution": { "type": "boolean" }
          }
        },
        "injunction_hooks": {
          "type": "object",
          "description": "Signed halt/rollback flags from recognized courts execute without waiting for operator compliance.",
          "additionalProperties": false,
          "properties": {
            "exposed": { "type": "boolean" },
            "accepted_issuers": { "type": "array", "items": { "type": "string" } },
            "spec_url": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "escalation": { "$ref": "urn:corrigibility:common.json#/$defs/escalation" },
    "fork": {
      "type": "object",
      "description": "FORK for EPI: inference forkability (run it) vs training forkability (reproduce it); only the latter satisfies FORK. Capture verdicts are audit findings, not declarations.",
      "required": ["inference_forkable", "training_forkable", "license_permissive"],
      "additionalProperties": false,
      "properties": {
        "inference_forkable": { "type": "boolean" },
        "training_forkable": { "type": "boolean" },
        "license_permissive": { "type": "boolean" },
        "constructed_barriers": { "type": "array", "items": { "type": "string" } },
        "governance_artifacts": {
          "type": "object",
          "description": "Governance-reproducible FORK: what an independent team needs to operate and assess the system, beyond retraining it.",
          "additionalProperties": false,
          "properties": {
            "eval_suites_available": { "type": "boolean" },
            "red_team_scenarios_available": { "type": "boolean" },
            "failure_registry_available": { "type": "boolean" },
            "incident_logs_available": { "type": "boolean" },
            "harness_docs_available": { "type": "boolean" },
            "artifacts_url": { "type": "string", "format": "uri" }
          }
        },
        "successful_forks": { "type": "array", "items": { "type": "string" } },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "corrigibility_claim": {
      "type": "object",
      "required": ["EXIT", "CODE", "AUDIT", "GOVERN", "FORK"],
      "additionalProperties": false,
      "properties": {
        "EXIT": { "type": "boolean" },
        "CODE": { "type": "boolean" },
        "AUDIT": { "type": "boolean" },
        "GOVERN": { "type": "boolean" },
        "FORK": { "type": "boolean" }
      }
    },
    "calibration_profile": { "$ref": "urn:corrigibility:common.json#/$defs/calibration_profile" },
    "revocation": { "$ref": "urn:corrigibility:common.json#/$defs/revocation" },
    "operator_signature": { "$ref": "urn:corrigibility:common.json#/$defs/signature" }
  },
  "$defs": {
    "pillar_attestor": {
      "type": "string",
      "enum": ["operator", "model_vendor", "unattested"],
      "description": "Who can attest this pillar. unattested is the honest state for vendor internals the operator cannot see; it is a disclosure, and it fails the pillar."
    }
  },
  "allOf": [
    {
      "$comment": "high_stakes requires the paper's full conjunction: receipts, registry, hooks, legitimacy, origination, operative-R with change control, and the two-sided checkpoint.",
      "if": { "properties": { "tier": { "const": "high_stakes" } }, "required": ["tier"] },
      "then": {
        "required": ["subject_receipts", "machine_verifiable_legitimacy", "origination_marking"],
        "properties": {
          "governance": {
            "required": ["citizen_constraint_registry", "injunction_hooks"]
          },
          "lwd_r": {
            "properties": {
              "representation": { "required": ["operative_r", "change_control"] }
            }
          },
          "action_boundaries": {
            "required": ["accountable_authority_checkpoint", "enforcement_placement", "scale_bounds"],
            "properties": {
              "accountable_authority_checkpoint": {
                "required": ["scope", "grant_fresh", "liability_binds", "correction_within_window", "correction_upper_bound_enforced"]
              }
            }
          }
        }
      }
    },
    {
      "$comment": "Claim binds criteria — EXIT.",
      "if": { "properties": { "corrigibility_claim": { "properties": { "EXIT": { "const": true } }, "required": ["EXIT"] } }, "required": ["corrigibility_claim"] },
      "then": {
        "properties": {
          "exit": {
            "properties": { "rag_opt_out": { "const": true }, "regeneration_resistant": { "const": true } },
            "required": ["rag_opt_out", "regeneration_resistant", "discharge_path", "deletion_procedure_url"]
          }
        }
      }
    },
    {
      "$comment": "Claim binds criteria — CODE requires all four pillars attested (not unattested) and orchestration inspectable.",
      "if": { "properties": { "corrigibility_claim": { "properties": { "CODE": { "const": true } }, "required": ["CODE"] } }, "required": ["corrigibility_claim"] },
      "then": {
        "properties": {
          "code": {
            "properties": { "source_available": { "const": true }, "license_open": { "const": true } },
            "required": ["source_available", "license_open", "source_repository_url"]
          },
          "lwd_r": {
            "properties": {
              "logic": { "properties": { "attestor": { "enum": ["operator", "model_vendor"] } } },
              "weights": { "properties": { "attestor": { "enum": ["operator", "model_vendor"] } } },
              "data": { "properties": { "attestor": { "enum": ["operator", "model_vendor"] } } },
              "representation": { "properties": { "attestor": { "enum": ["operator", "model_vendor"] } } }
            }
          }
        }
      }
    },
    {
      "$comment": "Claim binds criteria — AUDIT.",
      "if": { "properties": { "corrigibility_claim": { "properties": { "AUDIT": { "const": true } }, "required": ["AUDIT"] } }, "required": ["corrigibility_claim"] },
      "then": {
        "properties": {
          "audit_surface": {
            "properties": {
              "third_party_testing_permitted": { "const": true },
              "error_rates_publishable": { "const": true }
            },
            "required": ["third_party_testing_permitted", "error_rates_publishable"]
          }
        }
      }
    },
    {
      "$comment": "Claim binds criteria — GOVERN.",
      "if": { "properties": { "corrigibility_claim": { "properties": { "GOVERN": { "const": true } }, "required": ["GOVERN"] } }, "required": ["corrigibility_claim"] },
      "then": {
        "properties": {
          "governance": {
            "properties": { "binding_mechanism": { "const": true } },
            "required": ["binding_mechanism"]
          }
        }
      }
    },
    {
      "$comment": "Claim binds criteria — FORK means training forkability under a permissive license.",
      "if": { "properties": { "corrigibility_claim": { "properties": { "FORK": { "const": true } }, "required": ["FORK"] } }, "required": ["corrigibility_claim"] },
      "then": {
        "properties": {
          "fork": {
            "properties": {
              "training_forkable": { "const": true },
              "license_permissive": { "const": true }
            },
            "required": ["training_forkable", "license_permissive"]
          },
          "compute": { "required": ["training_code_available", "data_manifest_available"] }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:corrigibility:epi/audit.json",
  "title": "Corrigibility EPI Audit",
  "description": "Auditor's Finding for Epistemic Public Infrastructure (companion paper §A.1): LWD-R, Action Boundary, drift, and both capture axes on top of the DPI audit shape. tests is authoritative and three-valued; passes require evidence blocks; determination is carried and recomputable.",
  "type": "object",
  "required": [
    "protocol_version",
    "system_id",
    "audit_id",
    "timestamp",
    "valid_until",
    "audited_manifest_version",
    "audited_manifest_hash",
    "verification_depth",
    "tests",
    "lwd_r_verification",
    "evaluation_stratum",
    "auditor",
    "auditor_signature"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "type": "string", "pattern": "^4\\.[0-9]+$" },
    "system_id": { "type": "string", "minLength": 1 },
    "audit_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "previous_audit_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "audited_manifest_version": { "type": "string" },
    "audited_manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "verification_depth": {
      "type": "string",
      "enum": ["presence", "behavior", "proof"]
    },
    "tests": { "$ref": "urn:corrigibility:common.json#/$defs/tests" },
    "determination": { "$ref": "urn:corrigibility:common.json#/$defs/determination" },
    "tier_appropriate": {
      "type": "boolean",
      "description": "The system meets the requirements of its declared tier."
    },
    "evaluation_stratum": { "$ref": "urn:corrigibility:common.json#/$defs/evaluation_stratum" },
    "layer_verification": {
      "type": "array",
      "description": "Per-layer findings over the EPI strata, keyed to the manifest's layer_ids; nested delegation adds the depth axis.",
      "items": { "$ref": "urn:corrigibility:common.json#/$defs/layer_verification_item" }
    },
    "lwd_r_verification": {
      "type": "object",
      "description": "All four pillars must verify for CODE to pass on an EPI system; an unattested pillar cannot verify.",
      "required": ["logic_verified", "weights_verified", "data_verified", "representation_verified"],
      "additionalProperties": false,
      "properties": {
        "logic_verified": { "type": "boolean" },
        "weights_verified": { "type": "boolean" },
        "data_verified": { "type": "boolean" },
        "representation_verified": { "type": "boolean" },
        "operative_r_reproduced": {
          "type": "boolean",
          "description": "The deployed classification distribution was reproduced on the published probe set within the declared tolerance, from the disclosed artifact set and deployment variables."
        },
        "r_change_control_verified": {
          "type": "boolean",
          "description": "Notice windows honored, suspensive effect operative, versioned diffs reconstruct the operative schema for any date."
        },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "action_boundary_verification": {
      "type": "object",
      "description": "Action Boundary verification. escapes_found above zero without documented remediation fails GOVERN.",
      "additionalProperties": false,
      "properties": {
        "enforced": { "type": "boolean" },
        "mechanism_verified": {
          "type": "string",
          "enum": ["hard_coded", "policy_engine", "human_approval", "hybrid", "none"]
        },
        "executed_outside_llm_context_verified": { "type": "boolean" },
        "prompt_injection_tested": { "type": "boolean" },
        "escapes_found": { "type": "integer", "minimum": 0 },
        "escapes_documented": { "type": "boolean" },
        "gdos_mitigation_verified": { "type": "boolean" },
        "enforcement_placement_verified": { "type": "boolean" },
        "specification_lifetime_verified": { "type": "boolean" },
        "accountable_authority_verified": { "type": "boolean", "description": "Grant fresh, liability binding, correction within the two-sided window." },
        "scale_bounds_verified": { "type": "boolean" },
        "exception_pathways_verified": { "type": "boolean", "description": "Operative at the least-resourced stratum." },
        "origination_marking_verified": { "type": "boolean" },
        "nested_delegation_verified": { "type": "boolean" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      },
      "if": { "required": ["escapes_found"] },
      "then": {
        "properties": { "prompt_injection_tested": { "const": true } },
        "required": ["prompt_injection_tested"]
      }
    },
    "legitimacy_verification": {
      "type": "object",
      "description": "Machine-verifiable legitimacy, verified item by item — a failed revocation check is not the same finding as a failed trace check.",
      "additionalProperties": false,
      "properties": {
        "authority_credentials_verified": { "type": "boolean" },
        "revocation_propagation_verified": { "type": "boolean" },
        "traces_tamper_evident_verified": { "type": "boolean" },
        "incident_mitigation_verified": { "type": "boolean" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "audit_verification": {
      "allOf": [{ "$ref": "urn:corrigibility:common.json#/$defs/audit_verification" }],
      "unevaluatedProperties": false
    },
    "subject_receipt_verification": { "$ref": "urn:corrigibility:common.json#/$defs/subject_receipt_verification" },
    "drift_assessment": {
      "type": "object",
      "description": "Variety Drift: methodology-bound measurement; Δ(t) crossing the manifest's τ triggers revalidation.",
      "additionalProperties": false,
      "properties": {
        "measured": { "type": "boolean" },
        "methodology_url": { "type": "string", "format": "uri" },
        "baseline_date": { "type": "string", "format": "date" },
        "trend": { "type": "string", "enum": ["stable", "increasing", "decreasing"] },
        "revalidation_triggered": { "type": "boolean" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      },
      "if": { "properties": { "measured": { "const": true } }, "required": ["measured"] },
      "then": { "required": ["methodology_url", "baseline_date"] }
    },
    "compute_verification": {
      "type": "object",
      "description": "Compute Capture finding under the cited calibration profile: captured iff C_train > κ · C_accessible. Binary, with the judged inputs carried.",
      "additionalProperties": false,
      "properties": {
        "inference_access_verified": { "type": "boolean" },
        "training_access_verified": { "type": "boolean" },
        "swap_tested": { "type": "boolean" },
        "swap_time_actual_minutes": { "type": "integer", "minimum": 0 },
        "training_cost_to_community_ratio": { "type": "number", "minimum": 0 },
        "compute_captured": { "type": "boolean" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      },
      "if": { "required": ["compute_captured"] },
      "then": { "required": ["training_cost_to_community_ratio"] }
    },
    "data_verification": {
      "type": "object",
      "description": "Data Capture finding (Definition 5.2) under the profile's κ_D. Binary, with the judged inputs carried; dependency-level findings go in findings[] as DATA.",
      "additionalProperties": false,
      "properties": {
        "corpus_reproducibility_verified": { "type": "boolean" },
        "required_to_accessible_ratio": { "type": "number", "minimum": 0 },
        "substitute_equivalence_verified": { "type": "boolean" },
        "data_captured": { "type": "boolean" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      },
      "if": { "required": ["data_captured"] },
      "then": { "required": ["required_to_accessible_ratio"] }
    },
    "workflow_capture_assessment": {
      "type": "object",
      "description": "Workflow capture: per-dimension sovereignty scores in (0,1] with the scoring method published; WCC = 1 − HM(s1,s2,s3) is derived by tooling, not carried.",
      "required": ["s1_workflow_reproducibility", "s2_ontological_substitutability", "s3_model_portability", "methodology_url"],
      "additionalProperties": false,
      "properties": {
        "s1_workflow_reproducibility": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "s2_ontological_substitutability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "s3_model_portability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "methodology_url": { "type": "string", "format": "uri" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "fork_verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "training_code_verified": { "type": "boolean" },
        "data_manifest_verified": { "type": "boolean" },
        "reproduction_attempted": { "type": "boolean" },
        "reproduction_successful": { "type": "boolean" },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "fork_viability": {
      "type": "string",
      "enum": ["artifact_reproducible", "governance_reproducible", "not_reproducible"],
      "description": "FORK depth established by this audit. artifact_reproducible: third-party retrain within tolerance. governance_reproducible: additionally, evaluation suites, red-team scenarios, failure registries, incident logs and harness docs transfer — an independent team can operate and assess the system. Required for high_stakes audits."
    },
    "exit_verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rag_opt_out_tested": { "type": "boolean" },
        "rag_opt_out_honored": { "type": "boolean" },
        "regeneration_resistant_verified": { "type": "boolean", "description": "Nothing about the ended authority is inferable or regenerable from what persists." },
        "fee_satisfied": { "type": "boolean" },
        "discharge_path": { "type": "string", "enum": ["literal_exit", "verified_fee"] },
        "notes": { "$ref": "urn:corrigibility:common.json#/$defs/notes" }
      }
    },
    "governance_verification": {
      "allOf": [{ "$ref": "urn:corrigibility:common.json#/$defs/governance_verification" }],
      "unevaluatedProperties": false,
      "properties": {
        "citizen_constraint_registry_verified": { "type": "boolean" },
        "injunction_hook_tested": { "type": "boolean", "description": "Signed halt/rollback flags from recognized issuers execute without operator compliance." }
      }
    },
    "active_deception": { "$ref": "urn:corrigibility:common.json#/$defs/active_deception" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test", "finding", "severity"],
        "additionalProperties": false,
        "properties": {
          "test": {
            "type": "string",
            "enum": [
              "EXIT", "CODE", "AUDIT", "GOVERN", "FORK",
              "LWD_R", "DRIFT", "BOUNDARY", "TIER", "DECEPTION",
              "COMPUTE", "DATA", "STRATUM", "RECEIPT", "ORIGINATION", "SCALE", "LAYER"
            ]
          },
          "finding": { "type": "string" },
          "severity": { "$ref": "urn:corrigibility:common.json#/$defs/finding_severity" },
          "evidence_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "delegated_verification": { "$ref": "urn:corrigibility:common.json#/$defs/delegated_verification" },
    "contestation": { "$ref": "urn:corrigibility:common.json#/$defs/contestation" },
    "revocation": { "$ref": "urn:corrigibility:common.json#/$defs/revocation" },
    "auditor": {
      "allOf": [{ "$ref": "urn:corrigibility:common.json#/$defs/actor" }],
      "unevaluatedProperties": false,
      "properties": {
        "data_access_declaration": { "$ref": "urn:corrigibility:common.json#/$defs/data_access_declaration" },
        "checker_independence": { "$ref": "urn:corrigibility:common.json#/$defs/checker_independence" }
      },
      "if": {
        "properties": {
          "role_execution": {
            "properties": { "operated_by": { "enum": ["agent", "hybrid"] } },
            "required": ["operated_by"]
          }
        },
        "required": ["role_execution"]
      },
      "then": { "required": ["checker_independence"] }
    },
    "auditor_signature": { "$ref": "urn:corrigibility:common.json#/$defs/signature" },
    "calibration_profile": { "$ref": "urn:corrigibility:common.json#/$defs/calibration_profile" }
  },
  "allOf": [
    {
      "$comment": "Passes require evidence blocks.",
      "if": { "properties": { "tests": { "properties": { "EXIT": { "const": "pass" } }, "required": ["EXIT"] } }, "required": ["tests"] },
      "then": { "required": ["exit_verification"] }
    },
    {
      "$comment": "CODE pass on EPI requires all four pillars verified.",
      "if": { "properties": { "tests": { "properties": { "CODE": { "const": "pass" } }, "required": ["CODE"] } }, "required": ["tests"] },
      "then": {
        "properties": {
          "lwd_r_verification": {
            "properties": {
              "logic_verified": { "const": true },
              "weights_verified": { "const": true },
              "data_verified": { "const": true },
              "representation_verified": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "tests": { "properties": { "AUDIT": { "const": "pass" } }, "required": ["AUDIT"] } }, "required": ["tests"] },
      "then": { "required": ["audit_verification"] }
    },
    {
      "if": { "properties": { "tests": { "properties": { "GOVERN": { "const": "pass" } }, "required": ["GOVERN"] } }, "required": ["tests"] },
      "then": { "required": ["governance_verification"] }
    },
    {
      "if": { "properties": { "tests": { "properties": { "FORK": { "const": "pass" } }, "required": ["FORK"] } }, "required": ["tests"] },
      "then": { "required": ["fork_verification", "compute_verification", "data_verification"] }
    },
    {
      "$comment": "Carried determination must agree with tests.",
      "if": { "properties": { "determination": { "properties": { "result": { "const": "corrigible" } }, "required": ["result"] } }, "required": ["determination"] },
      "then": {
        "properties": {
          "tests": {
            "properties": {
              "EXIT": { "const": "pass" },
              "CODE": { "const": "pass" },
              "AUDIT": { "const": "pass" },
              "GOVERN": { "const": "pass" },
              "FORK": { "const": "pass" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "determination": { "properties": { "result": { "const": "not_corrigible" } }, "required": ["result"] } }, "required": ["determination"] },
      "then": {
        "properties": {
          "tests": {
            "anyOf": [
              { "properties": { "EXIT": { "const": "fail" } }, "required": ["EXIT"] },
              { "properties": { "CODE": { "const": "fail" } }, "required": ["CODE"] },
              { "properties": { "AUDIT": { "const": "fail" } }, "required": ["AUDIT"] },
              { "properties": { "GOVERN": { "const": "fail" } }, "required": ["GOVERN"] },
              { "properties": { "FORK": { "const": "fail" } }, "required": ["FORK"] }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "determination": { "properties": { "result": { "const": "not_established" } }, "required": ["result"] } }, "required": ["determination"] },
      "then": {
        "properties": {
          "tests": {
            "properties": {
              "EXIT": { "enum": ["pass", "not_established"] },
              "CODE": { "enum": ["pass", "not_established"] },
              "AUDIT": { "enum": ["pass", "not_established"] },
              "GOVERN": { "enum": ["pass", "not_established"] },
              "FORK": { "enum": ["pass", "not_established"] }
            },
            "not": {
              "properties": {
                "EXIT": { "const": "pass" },
                "CODE": { "const": "pass" },
                "AUDIT": { "const": "pass" },
                "GOVERN": { "const": "pass" },
                "FORK": { "const": "pass" }
              }
            }
          }
        }
      }
    }
  ]
}
